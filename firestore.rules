rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /signups/{id} {
      // Prefer registerSignup callable (deduped). Direct create allowed as fallback.
      allow create: if isValidSignup(request.resource.data);
      allow read, update, delete: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }

    match /siteConfig/{doc} {
      allow read, write: if false;
    }

    match /products/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSignup(data) {
  return data.keys().hasOnly(['contact', 'type', 'source', 'userAgent', 'createdAt'])
    && data.contact is string
    && data.contact.size() > 3
    && data.contact.size() < 200
    && data.type in ['email', 'phone']
    && data.source is string
    && data.source.size() < 100
    && data.userAgent is string
    && data.userAgent.size() < 1000
    && data.createdAt == request.time;
}
