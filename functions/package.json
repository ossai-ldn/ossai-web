{
  "name": "ossai-functions",
  "description": "Cloud Functions for Ossai signup welcome flow (email + SMS)",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
